{
  /* Cloudflare Workers static assets deployment (the dashboard's "import a
     Git repository" flow runs `npm run build` then `npx wrangler deploy`;
     this file tells wrangler what to publish).
     `not_found_handling: single-page-application` serves index.html for
     unmatched routes so the client router keeps /en/ canonical. Do NOT
     reintroduce public/_redirects: Workers rejects `/* -> /index.html`
     as a possible loop (code 100324). */
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "daymark-website",
  // Set this to today's date
  "compatibility_date": "2026-10-11",
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "single-page-application"
  }
}
